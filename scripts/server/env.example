# chanda server settings and secrets: keep this file at ~/.config/chanda/env with chmod 600.
# Long-lived Claude sign-in for the pipeline (from `claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=
# Channel ID where the pipeline posts its findings (Discord: Developer Mode on, right-click the channel, Copy Channel ID).
CHANDA_DISCORD_CHANNEL=
# The bot token is read from ~/.claude/channels/discord/.env, which /discord:configure writes; set DISCORD_BOT_TOKEN here only to override it.
# To post findings through a webhook instead of the bot, set DISCORD_WEBHOOK_URL.
# 1 = the Discord agent session also uses CLAUDE_CODE_OAUTH_TOKEN instead of your /login (test it first: see docs/SERVER.md).
CHANDA_AGENT_USE_TOKEN=0
# Extra flags for the agent session, e.g. --model opus
CHANDA_AGENT_ARGS=
