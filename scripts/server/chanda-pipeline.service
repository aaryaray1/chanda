[Unit]
Description=Chanda connection pipeline: one budgeted run

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
EnvironmentFile=-%h/.config/chanda/env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONIOENCODING=utf-8
UnsetEnvironment=ANTHROPIC_API_KEY
ExecStart=/usr/bin/python3 -I __ROOT__/scripts/connections_runner.py
TimeoutStartSec=5h
Nice=10
